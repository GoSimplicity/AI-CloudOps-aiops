FROM python:3.11.18-slim@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535

# 设置维护者信息
LABEL maintainer="AIOps Team"
LABEL description="AIOps Platform - MCP Server"

# 设置工作目录
WORKDIR /app

# 设置环境变量
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV PIP_DEFAULT_TIMEOUT=100
ENV ENV=production

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY requirements.txt .

# 安装Python依赖
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --only-binary=:all: -r requirements.txt

# 创建必要的目录
RUN mkdir -p data/models data/sample logs config

# 复制应用代码
COPY . .

# 确保配置目录有正确的权限
RUN chown -R root:root config && chmod -R 755 config

# 创建非root用户
RUN useradd --create-home --shell /bin/bash aiops && \
    chown -R aiops:aiops /app

USER aiops

# 暴露端口
EXPOSE 9000

# 存活探针只访问免鉴权的 GET /health，使用标准库。间隔与发布栈 mcp 服务一致。
# 监听端口来自 CMD 的 --port 9000。PORT 是 API 端口（默认 8080），探针不读它。
# 运行用户已是非 root（aiops）。
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9000/health', timeout=3)"]

# 启动MCP服务
CMD ["python", "-m", "app.mcp.main", "--host", "0.0.0.0", "--port", "9000"]
