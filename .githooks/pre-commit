#!/usr/bin/env bash
# pre-commit: 使用 gitleaks 扫描暂存内容，发现密钥即阻止提交（SEC-01A）。
# 启用: scripts/setup-git-hooks.sh
set -uo pipefail

# ---------------------------------------------------------------------------
# gitleaks: block commits that stage secrets (SEC-01A)
# ---------------------------------------------------------------------------
run_gitleaks_staged() {
    if ! command -v gitleaks >/dev/null 2>&1; then
        echo "[PRE-COMMIT ERROR] 未找到 gitleaks，已阻止提交。" >&2
        echo "  安装: https://github.com/gitleaks/gitleaks/releases (校验 sha256 后放入 PATH)" >&2
        echo "  然后执行: scripts/setup-git-hooks.sh" >&2
        exit 1
    fi
    local repo_root config_args=()
    repo_root="$(git rev-parse --show-toplevel)"
    [ -f "$repo_root/.gitleaks.toml" ] && config_args=(--config "$repo_root/.gitleaks.toml")
    # --ignore-gitleaks-allow：源码里的 "gitleaks:allow" 行内注释不再豁免任何发现（任何人都能在密钥行后加这条注释）；
    #   误报只能在 .gitleaks.toml 中按值精确放行（SEC-01A 第三轮 P3-1）。
    # ${config_args[@]+...}：macOS 自带 bash 3.2 在 set -u 下展开空数组会报 unbound variable。
    # gitleaks >= 8.19 uses `gitleaks git --staged`; older versions use `gitleaks protect --staged`.
    if gitleaks git --help 2>/dev/null | grep -q -- '--staged'; then
        gitleaks git --pre-commit --staged --redact --no-banner --verbose --ignore-gitleaks-allow \
            ${config_args[@]+"${config_args[@]}"} "$repo_root"
    else
        gitleaks protect --staged --redact --no-banner --verbose --ignore-gitleaks-allow \
            ${config_args[@]+"${config_args[@]}"} --source "$repo_root"
    fi
    local rc=$?
    if [ $rc -ne 0 ]; then
        echo "" >&2
        echo "[PRE-COMMIT ERROR] gitleaks 在暂存内容中发现疑似密钥（以上输出已脱敏），提交已被阻止。" >&2
        echo "  请移除密钥并改为环境变量/密钥管理；若确属误报，请在 .gitleaks.toml 中添加带注释的窄范围 allowlist。" >&2
        exit 1
    fi
    echo "[PRE-COMMIT] gitleaks: 暂存内容未发现密钥"
}
run_gitleaks_staged
exit 0
